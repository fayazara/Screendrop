      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop"
          }
        }
      }
    },
    "Screendrop Annotate" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop 标注"
          }
        }
      }
    },
    "Screendrop can't record until it's allowed under Privacy & Security > Screen & System Audio Recording. After turning it on, quit and reopen Screendrop - macOS applies the permission on relaunch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要在“隐私与安全性”>“录屏与系统录音”中允许后，Screendrop 才能录制。打开后，请退出并重新打开 Screendrop - macOS 会在重新启动时应用该权限。"
          }
        }
      }
    },
    "Screendrop can't use the camera because access is restricted on this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 限制了访问权限，因此 Screendrop 无法使用摄像头。"
          }
        }
      }
    },
    "Screendrop can't use the microphone because access is restricted on this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 限制了访问权限，因此 Screendrop 无法使用麦克风。"
          }
        }
      }
    },
    "Screendrop is a lightweight opensource app for capturing screenshots and screen recordings on macOS." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop 是一款轻量的开源应用，用于在 macOS 上截图和录屏。"
          }
        }
      }
    },
    "Screendrop is already recording." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop 已在录制。"
          }
