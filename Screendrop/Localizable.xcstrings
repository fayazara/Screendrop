        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop 录制编辑器"
          }
        }
      }
    },
    "Screendrop will finish and save the recording before quitting. This can take a moment for a long recording." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screendrop 会在退出前完成并存储录制。较长的录制可能需要一些时间。"
          }
        }
      }
    },
    "Screendrop will finish and save the recording before quitting. You also have %lld unsaved captures that will be discarded." : {
      "localizations" : {
        "zh-Hans" : {
